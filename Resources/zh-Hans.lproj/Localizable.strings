/* Directory access and operation feedback */
"OK" = "好";
"There are no file paths to copy." = "没有可复制的文件路径。";
"The clipboard could not be updated. Try copying the paths again." = "无法更新剪贴板，请重新复制路径。";
"The target folder no longer exists." = "目标文件夹已不存在。";
"MacRight Could Not Complete the Operation" = "MacRight 无法完成操作";
"The new file name must be a single nonempty name." = "新文件名不能为空，也不能包含路径。";
"The destination is no longer a folder." = "目标位置已不再是文件夹。";
