/* MacRight app */
"Finder extension is enabled" = "Finder 扩展已启用";
"Finder extension is not enabled" = "Finder 扩展尚未启用";
"Right-click in Finder or on your desktop to use MacRight." = "在 Finder 或桌面上右键，即可使用 MacRight。";
"Open extension settings and enable MacRight, then return here to check its status." = "打开扩展设置并启用 MacRight，然后返回这里查看状态。";
"Open Extension Settings" = "打开扩展设置";
"Terminal Application" = "终端应用";
"No Terminal Application Selected" = "尚未选择终端应用";
"Choose Terminal Application…" = "选择终端应用…";
"Choose" = "选择";
"Choose the terminal application to open folders from Finder." = "请选择用于从 Finder 打开文件夹的终端应用。";
"The selected terminal application could not be found. Choose it again." = "未找到所选终端应用，请重新选择。";
"System Terminal" = "系统终端";
"The preferred terminal setting is invalid. Choose a terminal in MacRight." = "首选终端设置无效，请在 MacRight 中重新选择终端。";
"The terminal preference could not be synchronized. Try again." = "无法同步终端设置，请重试。";
"Choose a valid application (.app)." = "请选择有效的应用程序（.app）。";
"The selected application %@ is unavailable at its saved location." = "在已保存的位置找不到所选应用 %@。";
"Choose the application again in MacRight." = "请在 MacRight 中重新选择该应用。";

